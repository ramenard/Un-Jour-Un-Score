# API URL Configuration
# Copy this file to .env and adjust the URL for your environment:
#
# Android Emulator:   EXPO_PUBLIC_API_URL=http://10.0.2.2:3001
# iOS Simulator:      EXPO_PUBLIC_API_URL=http://localhost:3001
# Physical Device:    EXPO_PUBLIC_API_URL=http://192.168.X.X:3001  (replace with your local IP)
# Production:         EXPO_PUBLIC_API_URL=https://your-api.example.com

EXPO_PUBLIC_API_URL=http://localhost:3001
